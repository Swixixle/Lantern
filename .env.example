# Lantern Environment Variables

# Database Configuration
# Required: PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
# On Replit, this is automatically provided when you add the PostgreSQL module
DATABASE_URL=postgresql://user:password@localhost:5432/lantern

# Server Configuration
# Port for the application (default: 5000)
PORT=5000

# Node Environment (development or production)
NODE_ENV=development

# Optional: API key for restricted endpoints
# If not set, certain API endpoints will be publicly accessible
LANTERN_API_KEY=

# Optional: Enable public readonly mode
# Set to "true" to allow public access without API key (read-only)
LANTERN_PUBLIC_READONLY=false
